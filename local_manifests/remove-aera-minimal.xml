    <remove-project name="platform/external/rust/cros-libva" />
    <remove-project name="platform/external/rust/cxx" />
    <remove-project name="platform/external/rust/pica" />
    <remove-project name="platform/external/tflite-support" />
    <!-- kernel: racer uses its own prebuilt 4.19 kernel in device tree -->
    <remove-project name="kernel/prebuilts/6.1/arm64" />
    <remove-project name="kernel/prebuilts/6.12/arm64" />
