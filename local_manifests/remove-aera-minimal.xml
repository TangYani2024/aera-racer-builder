<?xml version="1.0" encoding="UTF-8"?>
<!--
  AERA racer minimal-sync remove list.
  Place in .repo/local_manifests/ before repo sync.
  Note: 595 projects already removed by upstream remove-minimal.xml are omitted
  here to avoid duplicate remove-project errors. Core C/C++ libraries, host
  sysroots/toolchains, and packages/modules/common (required by Soong
  framework-module-defaults) are kept so recoveryimage + adbd build cleanly.
-->
<manifest>
    <!-- build: bazel rules unused by Soong recovery build -->
    <remove-project name="platform/build/bazel" />
    <remove-project name="platform/build/bazel_common_rules" />
    <remove-project name="platform/build/pesto" />
    <!-- external: keep only large/unused toolchains, fonts, and bazel/rust repos removed -->
    <remove-project name="platform/external/AFLplusplus" />
    <remove-project name="platform/external/bazel-skylib" />
    <remove-project name="platform/external/bazelbuild-kotlin-rules" />
    <remove-project name="platform/external/bazelbuild-platforms" />
    <remove-project name="platform/external/bazelbuild-remote-apis" />
    <remove-project name="platform/external/bazelbuild-rules_android" />
    <remove-project name="platform/external/bazelbuild-rules_cc" />
    <remove-project name="platform/external/bazelbuild-rules_go" />
    <remove-project name="platform/external/bazelbuild-rules_java" />
    <remove-project name="platform/external/bazelbuild-rules_license" />
    <remove-project name="platform/external/bazelbuild-rules_python" />
    <remove-project name="platform/external/bazelbuild-rules_rust" />
    <remove-project name="platform/external/bazelbuild-rules_testing" />
    <remove-project name="platform/external/clang" />
    <remove-project name="platform/external/cronet" />
    <remove-project name="platform/external/dng_sdk" />
    <remove-project name="platform/external/llvm" />
    <remove-project name="platform/external/noto-fonts" />
    <remove-project name="platform/external/openwrt-prebuilts" />
    <remove-project name="platform/external/roboto-fonts" />
    <remove-project name="platform/external/rust/android-crates-io" />
    <remove-project name="platform/external/rust/autocxx" />
